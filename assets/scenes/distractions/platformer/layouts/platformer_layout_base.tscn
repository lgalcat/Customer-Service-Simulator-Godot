[node name="Stage" type="Node2D" unique_id=947272391]
editor_description = "Base of every Platformer layout (layouts are inherited scenes of this one) and the root of the minigame's level.
Layout authoring: paint Ground, place Player (the spawn) and Goal, and set Player/MainCamera's limits to the level's bounds.
- The camera limits must enclose the spawn and the Goal (Setup throws otherwise).
- Seal the playspace: no gap in Ground may let the player leave the camera limits.
- Keep the Goal within one held jump of the platform beneath it."
script = ExtResource("1_layout")

