{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "sceneToRun",
            "type": "promptString",
            "description": "res:// path to desired scene file",
            // [5/08/2026] By default choose the distraction sandbox, when a main scene exists this should change
            "default": "res://assets/scenes/distractions/distraction_sandbox.tscn"
        }
    ],
    "configurations": [
        {
            "name": "Launch Main Scene",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT_BIN}",
            "args": [
                "--path",
                "${workspaceRoot}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Debug Distraction Sandbox",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT_BIN}",
            "args": [
                "--path",
                "${workspaceFolder}",
                "res://assets/scenes/distractions/distraction_sandbox.tscn",
                "--remote-debug", "tcp://127.0.0.1:6007"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        },
        {
            "name": "Debug Select Scene",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${env:GODOT_BIN}",
            "args": [
                "--path",
                "${workspaceFolder}",
                "${input:SceneToRun}",
                "--remote-debug", "tcp://127.0.0.1:6007"
            ],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole"
        }
    ]
}
